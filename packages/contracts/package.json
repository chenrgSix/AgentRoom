{
  "name": "@convene-wire/contracts",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Authoritative JSON Schema contracts for ConveneWire",
  "type": "module",
  "exports": {
    "./bridge-messages": "./generated/typescript/bridge-messages.ts",
    "./pairing-session": "./generated/typescript/pairing-session.ts",
    "./task-result": "./generated/typescript/task-result.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run check:generated && node scripts/build.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "check:types": "tsc --noEmit --strict --skipLibCheck --target ES2022 generated/typescript/bridge-messages.ts generated/typescript/pairing-session.ts generated/typescript/task-result.ts",
    "generate": "node scripts/generate.mjs",
    "test": "node --test && npm run check:generated && npm run check:types && go test ./generated/go/... ./test/go",
    "validate": "node scripts/validate.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "quicktype-core": "26.0.0",
    "typescript": "7.0.2"
  }
}
