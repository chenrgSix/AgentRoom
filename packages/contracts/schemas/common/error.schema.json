{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentroom.dev/schemas/common/error.schema.json",
  "title": "ConveneWire Error",
  "description": "Stable, client-safe error returned at a protocol boundary.",
  "type": "object",
  "required": [
    "code",
    "message",
    "retryable"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "details": {
      "description": "Explicit extension point for bounded, client-safe structured diagnostics. Owning services apply the field allowlist.",
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "exitCode": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "stderrCaptured": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "retryable": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
