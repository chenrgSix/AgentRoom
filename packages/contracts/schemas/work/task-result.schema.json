{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentroom.dev/schemas/work/task-result.schema.json",
  "title": "ConveneWire Task, Run, Result, and Workbench Contracts",
  "description": "Closed cross-boundary work-model contracts. These objects carry no local path, command, environment, provider credential, or mutable display identity authority.",
  "$ref": "#/$defs/resultProposal",
  "$defs": {
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nonNegativeRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "criterionKey": {
      "type": "string",
      "pattern": "^criterion_[A-Za-z0-9_-]{8,64}$"
    },
    "evidenceRefId": {
      "type": "string",
      "pattern": "^evidence_[A-Za-z0-9_-]{8,64}$"
    },
    "nextActionKey": {
      "type": "string",
      "pattern": "^next_[A-Za-z0-9_-]{8,64}$"
    },
    "lifecycleState": {
      "enum": ["draft", "ready", "active", "review", "completed", "canceled"]
    },
    "schedulingState": {
      "enum": ["enabled", "paused"]
    },
    "completionPolicy": {
      "enum": ["owner_confirmed", "accepted_result_required"]
    },
    "priority": {
      "enum": ["low", "normal", "high", "urgent"]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionKey", "description", "required", "ordinal"],
      "properties": {
        "criterionKey": { "$ref": "#/$defs/criterionKey" },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "required": { "type": "boolean" },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "criteriaRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteriaRevision", "criteria"],
      "properties": {
        "criteriaRevision": { "$ref": "#/$defs/revision" },
        "criteria": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/criterion" }
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId", "role", "assignedByMemberId", "assignedAt"],
      "properties": {
        "agentId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/agentId" },
        "role": { "enum": ["primary", "contributor", "reviewer"] },
        "assignedByMemberId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/memberId" },
        "assignedAt": { "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json" }
      }
    },
    "assignmentCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId", "role"],
      "properties": {
        "agentId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/agentId" },
        "role": { "enum": ["primary", "contributor", "reviewer"] }
      }
    },
    "budgetPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRunAttempts", "maxExecutionDurationSeconds"],
      "properties": {
        "maxRunAttempts": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maxExecutionDurationSeconds": { "type": "integer", "minimum": 1, "maximum": 2592000 }
      }
    },
    "budgetUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usageRevision", "runAttempts", "executionDurationSeconds", "providerTokens", "providerCostUsd"],
      "properties": {
        "usageRevision": { "$ref": "#/$defs/nonNegativeRevision" },
        "runAttempts": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "executionDurationSeconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "providerTokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "providerCostUsd": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "attentionReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "sourceId", "occurredAt", "actorKind"],
      "properties": {
        "reason": {
          "enum": ["needs_input", "outcome_unknown", "needs_approval", "result_stale", "blocked", "overdue", "paused", "budget_exhausted", "runtime_unavailable", "result_rejected"]
        },
        "sourceId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/opaqueId" },
        "occurredAt": { "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json" },
        "actorKind": { "enum": ["member", "agent", "system"] },
        "expectedMemberId": {
          "oneOf": [
            { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/memberId" },
            { "type": "null" }
          ]
        },
        "expectedAgentId": {
          "oneOf": [
            { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/agentId" },
            { "type": "null" }
          ]
        }
      }
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorKind", "reason", "sourceId"],
      "properties": {
        "actorKind": { "enum": ["member", "agent", "system"] },
        "reason": {
          "enum": ["provide_input", "acknowledge_outcome", "review_result", "resolve_block", "resume_scheduling", "increase_budget", "restore_runtime", "submit_result", "start_work", "none"]
        },
        "sourceId": {
          "oneOf": [
            { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/opaqueId" },
            { "type": "null" }
          ]
        },
        "expectedMemberId": {
          "oneOf": [
            { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/memberId" },
            { "type": "null" }
          ]
        },
        "expectedAgentId": {
          "oneOf": [
            { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/agentId" },
            { "type": "null" }
          ]
        }
      }
    },
    "taskProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId", "taskDisplayNumber", "teamId", "roomId", "parentTaskId",
        "title", "goal", "ownerMemberId", "lifecycleState", "schedulingState",
        "completionPolicy", "priority", "dueAt", "taskRevision",
        "definitionRevision", "criteriaRevision", "criteria", "assignments",
        "budgetPolicy", "budgetUsage", "completionResultId", "attentionReasons",
        "nextAction", "isDefault", "createdByMemberId", "createdAt", "updatedAt"
      ],
      "properties": {
        "taskId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/taskId" },
        "taskDisplayNumber": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "teamId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/teamId" },
        "roomId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/roomId" },
        "parentTaskId": {
          "oneOf": [
            { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/taskId" },
            { "type": "null" }
          ]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "goal": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "ownerMemberId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/memberId" },
        "lifecycleState": { "$ref": "#/$defs/lifecycleState" },
        "schedulingState": { "$ref": "#/$defs/schedulingState" },
        "completionPolicy": { "$ref": "#/$defs/completionPolicy" },
        "priority": { "$ref": "#/$defs/priority" },
        "dueAt": {
          "oneOf": [
            { "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json" },
            { "type": "null" }
          ]
        },
        "taskRevision": { "$ref": "#/$defs/revision" },
        "definitionRevision": { "$ref": "#/$defs/revision" },
        "criteriaRevision": { "$ref": "#/$defs/revision" },
        "criteria": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/criterion" } },
        "assignments": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/assignment" } },
        "budgetPolicy": { "$ref": "#/$defs/budgetPolicy" },
        "budgetUsage": { "$ref": "#/$defs/budgetUsage" },
        "completionResultId": {
          "oneOf": [
            { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/resultId" },
            { "type": "null" }
          ]
        },
        "attentionReasons": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/attentionReason" }
        },
        "nextAction": { "$ref": "#/$defs/nextAction" },
        "isDefault": { "type": "boolean" },
        "createdByMemberId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/memberId" },
        "createdAt": { "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json" },
        "updatedAt": { "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json" }
      }
    },
    "taskDefinitionCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "expectedTaskRevision", "title", "goal", "ownerMemberId", "completionPolicy", "priority", "dueAt", "criteria", "assignments", "budgetPolicy"],
      "properties": {
        "operationId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/operationId" },
        "expectedTaskRevision": { "$ref": "#/$defs/revision" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "goal": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "ownerMemberId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/memberId" },
        "completionPolicy": { "$ref": "#/$defs/completionPolicy" },
        "priority": { "$ref": "#/$defs/priority" },
        "dueAt": {
          "oneOf": [
            { "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json" },
            { "type": "null" }
          ]
        },
        "criteria": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/criterion" } },
        "assignments": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/assignmentCommand" } },
        "budgetPolicy": { "$ref": "#/$defs/budgetPolicy" }
      }
    },
    "runAttemptProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "taskId", "agentId", "attemptNumber", "retryOfRunId", "state", "phase", "createdAt", "updatedAt"],
      "properties": {
        "runId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/runId" },
        "taskId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/taskId" },
        "agentId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/agentId" },
        "attemptNumber": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "retryOfRunId": {
          "oneOf": [
            { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/runId" },
            { "type": "null" }
          ]
        },
        "state": { "enum": ["queued", "delivered", "working", "input_required", "completed", "failed", "canceled", "expired", "outcome_unknown"] },
        "phase": { "enum": ["sending", "preparing_context", "starting_runtime", "running", "running_tests", "submitting_result", "unknown"] },
        "createdAt": { "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json" },
        "updatedAt": { "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json" }
      }
    },
    "contextManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestVersion", "runId", "taskId", "taskRevision", "definitionRevision", "criteriaRevision", "goal", "criteria", "target", "included", "permissions", "omittedCategories", "recordedAt"],
      "properties": {
        "execution": { "$ref": "https://agentroom.dev/schemas/work/execution-runtime.schema.json#/$defs/manifest" },
        "manifestVersion": { "const": "1.0" },
        "runId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/runId" },
        "taskId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/taskId" },
        "taskRevision": { "$ref": "#/$defs/revision" },
        "definitionRevision": { "$ref": "#/$defs/revision" },
        "criteriaRevision": { "$ref": "#/$defs/revision" },
        "goal": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "criteria": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/criterion" } },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agentId", "deviceId", "runtimeKind", "workspaceAlias"],
          "properties": {
            "agentId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/agentId" },
            "deviceId": {
              "oneOf": [
                { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/deviceId" },
                { "type": "null" }
              ]
            },
            "runtimeKind": { "enum": ["codex", "pi", "generic", "fake", "manual", "not_recorded"] },
            "workspaceAlias": { "type": ["string", "null"], "minLength": 1, "maxLength": 120, "pattern": "^[^/\\\\:]+$" }
          }
        },
        "included": {
          "type": "object",
          "additionalProperties": false,
          "required": ["messageIds", "artifactIds", "memoryIds", "parentRunIds", "roomContextRevision", "taskMemoryRevision", "artifactRevision"],
          "properties": {
            "messageIds": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/messageId" } },
            "artifactIds": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/artifactId" } },
            "memoryIds": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/memoryId" } },
            "parentRunIds": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/runId" } },
            "roomContextRevision": { "$ref": "#/$defs/nonNegativeRevision" },
            "taskMemoryRevision": { "$ref": "#/$defs/nonNegativeRevision" },
            "artifactRevision": { "$ref": "#/$defs/nonNegativeRevision" }
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filesystemAccess", "networkAccess", "interrupt", "handoff", "maxDurationSeconds"],
          "properties": {
            "filesystemAccess": { "enum": ["read-only", "workspace-write", "local-policy", "not_recorded"] },
            "networkAccess": { "enum": ["disabled", "local-policy", "not_recorded"] },
            "interrupt": { "enum": ["supported", "unsupported", "not_recorded"] },
            "handoff": { "enum": ["supported", "unsupported", "not_recorded"] },
            "maxDurationSeconds": { "type": ["integer", "null"], "minimum": 1, "maximum": 86400 }
          }
        },
        "omittedCategories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["unrelated_room_history", "local_paths", "environment_values", "provider_credentials", "provider_session_ids", "hidden_reasoning", "tool_payloads", "other_workspaces"] }
        },
        "recordedAt": { "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json" }
      }
    },
    "ambiguityAcknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "runId", "expectedTaskRevision", "reason"],
      "properties": {
        "operationId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/operationId" },
        "runId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/runId" },
        "expectedTaskRevision": { "$ref": "#/$defs/revision" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "artifactEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceRefId", "kind", "artifactId"],
      "properties": {
        "evidenceRefId": { "$ref": "#/$defs/evidenceRefId" },
        "kind": { "const": "artifact" },
        "artifactId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/artifactId" }
      }
    },
    "runEventEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceRefId", "kind", "runId", "sequence"],
      "properties": {
        "evidenceRefId": { "$ref": "#/$defs/evidenceRefId" },
        "kind": { "const": "run_event" },
        "runId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/runId" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "messageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceRefId", "kind", "messageId"],
      "properties": {
        "evidenceRefId": { "$ref": "#/$defs/evidenceRefId" },
        "kind": { "const": "message" },
        "messageId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/messageId" }
      }
    },
    "memoryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceRefId", "kind", "memoryId"],
      "properties": {
        "evidenceRefId": { "$ref": "#/$defs/evidenceRefId" },
        "kind": { "const": "memory" },
        "memoryId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/memoryId" }
      }
    },
    "discussionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceRefId", "kind", "discussionId"],
      "properties": {
        "evidenceRefId": { "$ref": "#/$defs/evidenceRefId" },
        "kind": { "const": "discussion" },
        "discussionId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/discussionId" }
      }
    },
    "evidenceReference": {
      "oneOf": [
        { "$ref": "#/$defs/artifactEvidence" },
        { "$ref": "#/$defs/runEventEvidence" },
        { "$ref": "#/$defs/messageEvidence" },
        { "$ref": "#/$defs/memoryEvidence" },
        { "$ref": "#/$defs/discussionEvidence" }
      ]
    },
    "criterionClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionKey", "coverage", "explanation", "evidenceRefIds"],
      "properties": {
        "criterionKey": { "$ref": "#/$defs/criterionKey" },
        "coverage": { "enum": ["satisfied", "unresolved", "not_satisfied", "not_applicable"] },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "evidenceRefIds": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceRefId" } }
      }
    },
    "resultNextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nextActionKey", "description"],
      "properties": {
        "nextActionKey": { "$ref": "#/$defs/nextActionKey" },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "resultProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "taskId", "definitionRevision", "criteriaRevision", "proposedAtTaskRevision", "supersedesResultId", "outcome", "summary", "risks", "openQuestions", "nextActions", "sources", "criterionClaims"],
      "properties": {
        "operationId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/operationId" },
        "taskId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/taskId" },
        "definitionRevision": { "$ref": "#/$defs/revision" },
        "criteriaRevision": { "$ref": "#/$defs/revision" },
        "proposedAtTaskRevision": { "$ref": "#/$defs/revision" },
        "supersedesResultId": {
          "oneOf": [
            { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/resultId" },
            { "type": "null" }
          ]
        },
        "outcome": { "enum": ["satisfied", "partial", "not_satisfied", "informational"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "risks": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
        "openQuestions": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
        "nextActions": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/resultNextAction" } },
        "sources": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/evidenceReference" } },
        "criterionClaims": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/criterionClaim" } }
      }
    },
    "agentResultProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorKind", "agentId", "runId", "proposal"],
      "properties": {
        "actorKind": { "enum": ["manual_agent", "managed_agent"] },
        "agentId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/agentId" },
        "runId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/runId" },
        "proposal": { "$ref": "#/$defs/resultProposal" }
      }
    },
    "resultReviewCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "decision", "expectedTaskRevision", "expectedReviewRevision", "reason", "completeTask"],
      "properties": {
        "operationId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/operationId" },
        "decision": { "enum": ["accepted", "rejected"] },
        "expectedTaskRevision": { "$ref": "#/$defs/revision" },
        "expectedReviewRevision": { "$ref": "#/$defs/nonNegativeRevision" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "completeTask": { "type": "boolean" }
      }
    },
    "resultReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reviewRevision", "reviewedByMemberId", "reason", "reviewedAt"],
      "properties": {
        "decision": { "enum": ["accepted", "rejected"] },
        "reviewRevision": { "$ref": "#/$defs/revision" },
        "reviewedByMemberId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/memberId" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "reviewedAt": { "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json" }
      }
    },
    "resultProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resultId", "resultVersion", "taskId", "roomId", "state", "proposal", "review", "proposedBy", "proposedAt"],
      "properties": {
        "resultId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/resultId" },
        "resultVersion": { "$ref": "#/$defs/revision" },
        "taskId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/taskId" },
        "roomId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/roomId" },
        "state": { "enum": ["proposed", "accepted", "rejected", "superseded"] },
        "proposal": { "$ref": "#/$defs/resultProposal" },
        "review": {
          "oneOf": [
            { "$ref": "#/$defs/resultReview" },
            { "type": "null" }
          ]
        },
        "proposedBy": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "memberId"],
              "properties": {
                "kind": { "const": "member" },
                "memberId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/memberId" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "agentId", "runId"],
              "properties": {
                "kind": { "enum": ["manual_agent", "managed_agent"] },
                "agentId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/agentId" },
                "runId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/runId" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "discussionId"],
              "properties": {
                "kind": { "const": "orchestrator" },
                "discussionId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/discussionId" }
              }
            }
          ]
        },
        "proposedAt": { "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json" }
      }
    },
    "workbenchItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "taskDisplayNumber", "roomId", "title", "ownerMemberId", "lifecycleState", "schedulingState", "priority", "attentionReasons", "primaryAttention", "latestRun", "latestResultId", "latestResultCurrent", "requiredCriteriaSatisfied", "requiredCriteriaTotal", "budgetUsage", "nextAction", "updatedAt"],
      "properties": {
        "taskId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/taskId" },
        "taskDisplayNumber": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "roomId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/roomId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "ownerMemberId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/memberId" },
        "lifecycleState": { "$ref": "#/$defs/lifecycleState" },
        "schedulingState": { "$ref": "#/$defs/schedulingState" },
        "priority": { "$ref": "#/$defs/priority" },
        "attentionReasons": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/attentionReason" } },
        "primaryAttention": { "type": ["string", "null"], "enum": ["needs_input", "outcome_unknown", "needs_approval", "result_stale", "blocked", "overdue", "paused", "budget_exhausted", "runtime_unavailable", "result_rejected", null] },
        "latestRun": {
          "oneOf": [
            { "$ref": "#/$defs/runAttemptProjection" },
            { "type": "null" }
          ]
        },
        "latestResultId": {
          "oneOf": [
            { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/resultId" },
            { "type": "null" }
          ]
        },
        "latestResultCurrent": { "type": ["boolean", "null"] },
        "requiredCriteriaSatisfied": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "requiredCriteriaTotal": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "budgetUsage": { "$ref": "#/$defs/budgetUsage" },
        "nextAction": { "$ref": "#/$defs/nextAction" },
        "updatedAt": { "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json" }
      }
    },
    "workbenchPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "nextCursor"],
      "properties": {
        "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/workbenchItem" } },
        "nextCursor": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{8,512}$" }
      }
    },
    "workbenchQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "attention", "lifecycleState", "limit", "cursor"],
      "properties": {
        "scope": { "enum": ["mine", "team"] },
        "search": {
          "type": "string",
          "maxLength": 100,
          "description": "Optional trimmed Task title search. Case-insensitive literal title substrings match; numeric or TASK-n text also matches the exact Team display number. Empty text is equivalent to omission."
        },
        "attention": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "enum": ["needs_input", "outcome_unknown", "needs_approval", "result_stale", "blocked", "overdue", "paused", "budget_exhausted", "runtime_unavailable", "result_rejected"] }
        },
        "lifecycleState": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/lifecycleState" }
        },
        "priority": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/priority" }
        },
        "ownerMemberId": {
          "oneOf": [
            { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/memberId" },
            { "type": "null" }
          ]
        },
        "roomId": {
          "oneOf": [
            { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/roomId" },
            { "type": "null" }
          ]
        },
        "agentId": {
          "oneOf": [
            { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/agentId" },
            { "type": "null" }
          ]
        },
        "updatedAfter": {
          "oneOf": [
            { "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json" },
            { "type": "null" }
          ]
        },
        "updatedBefore": {
          "oneOf": [
            { "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json" },
            { "type": "null" }
          ]
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "cursor": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{8,512}$" }
      }
    },
    "legacyTaskMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacyState", "lifecycleState", "schedulingState", "completionPolicy", "isDefault"],
      "properties": {
        "legacyState": { "enum": ["open", "working", "blocked", "review", "completed", "canceled"] },
        "lifecycleState": { "$ref": "#/$defs/lifecycleState" },
        "schedulingState": { "$ref": "#/$defs/schedulingState" },
        "completionPolicy": { "$ref": "#/$defs/completionPolicy" },
        "isDefault": { "type": "boolean" }
      }
    },
    "childTaskFromResultCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "nextActionKey", "title", "ownerMemberId"],
      "properties": {
        "operationId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/operationId" },
        "nextActionKey": { "$ref": "#/$defs/nextActionKey" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "ownerMemberId": { "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/memberId" }
      }
    }
  }
}
