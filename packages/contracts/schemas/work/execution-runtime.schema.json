{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentroom.dev/schemas/work/execution-runtime.schema.json",
  "title": "ConveneWire Governed Execution Runtime Contracts",
  "description": "Closed structural contracts. A valid object is not a grant, input authority or verified observation. All actors, fingerprints, expiry, scope and current operation ownership require domain admission.",
  "$ref": "#/$defs/manifest",
  "$defs": {
    "version": {
      "type": "integer",
      "const": 1,
      "minimum": 1,
      "maximum": 1
    },
    "operationKind": {
      "enum": [
        "prepare",
        "capture",
        "verify",
        "integrate",
        "publish",
        "observe"
      ]
    },
    "inputBindingId": {
      "type": "string",
      "pattern": "^input_[A-Za-z0-9_-]{8,128}$"
    },
    "checkpointId": {
      "type": "string",
      "pattern": "^checkpoint_[A-Za-z0-9_-]{8,128}$"
    },
    "verificationId": {
      "type": "string",
      "pattern": "^verification_[A-Za-z0-9_-]{8,128}$"
    },
    "providerBindingId": {
      "type": "string",
      "pattern": "^provider_[A-Za-z0-9_-]{8,128}$"
    },
    "profilePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "revision",
        "digest"
      ],
      "properties": {
        "profileId": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/profileId"
        },
        "revision": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/revision"
        },
        "digest": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/digest"
        }
      }
    },
    "planPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId",
        "revision",
        "digest",
        "approvalOperationId",
        "roomId",
        "rootTaskId"
      ],
      "properties": {
        "planId": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/planId"
        },
        "revision": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/revision"
        },
        "digest": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/digest"
        },
        "approvalOperationId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/operationId"
        },
        "roomId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/roomId"
        },
        "rootTaskId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/taskId"
        }
      }
    },
    "executionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId",
        "planRevision",
        "planDigest",
        "approvalOperationId",
        "planControlRevision",
        "nodeKey",
        "dispatchGeneration",
        "roomId",
        "taskId",
        "taskRevision",
        "definitionRevision",
        "criteriaRevision",
        "runId",
        "agentId",
        "deviceId"
      ],
      "properties": {
        "planId": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/planId"
        },
        "planRevision": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/revision"
        },
        "planDigest": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/digest"
        },
        "approvalOperationId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/operationId"
        },
        "planControlRevision": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/revision"
        },
        "nodeKey": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/stableKey"
        },
        "dispatchGeneration": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/revision"
        },
        "roomId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/roomId"
        },
        "taskId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/taskId"
        },
        "taskRevision": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/revision"
        },
        "definitionRevision": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/revision"
        },
        "criteriaRevision": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/revision"
        },
        "runId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/runId"
        },
        "agentId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/agentId"
        },
        "deviceId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/deviceId"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "workspaceBoundary",
        "preventivePathEnforcement",
        "operations"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "workspaceBoundary": {
          "const": "enforced"
        },
        "preventivePathEnforcement": {
          "type": "boolean"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/operationKind"
          },
          "uniqueItems": true
        },
        "readyGrants": {
          "description": "Path-free current local grant summaries available to one published Agent. Omission means no admission-ready grant was published and grants no authority.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/grantSummary"
          }
        }
      }
    },
    "grantSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grantId",
        "revision",
        "digest",
        "expiresAt"
      ],
      "properties": {
        "grantId": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/grantId"
        },
        "revision": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/revision"
        },
        "digest": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/digest"
        },
        "expiresAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        }
      }
    },
    "artifactSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "artifactRevision",
        "contentDigest",
        "byteLength",
        "kind"
      ],
      "properties": {
        "artifactId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/artifactId"
        },
        "artifactRevision": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/revision"
        },
        "contentDigest": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/digest"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "kind": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/artifactKind"
        }
      }
    },
    "workspaceLease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaseId",
        "workspaceRef",
        "workspaceGeneration",
        "mode",
        "issuedAt",
        "expiresAt"
      ],
      "properties": {
        "leaseId": {
          "type": "string",
          "pattern": "^lease_[A-Za-z0-9_-]{8,128}$"
        },
        "workspaceRef": {
          "$ref": "https://agentroom.dev/schemas/bridge/messages.schema.json#/$defs/workspaceRef"
        },
        "workspaceGeneration": {
          "$ref": "https://agentroom.dev/schemas/bridge/messages.schema.json#/$defs/workspaceGeneration"
        },
        "mode": {
          "const": "isolated_worktree"
        },
        "issuedAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        },
        "expiresAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        }
      }
    },
    "runtimeAuthorityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "runId",
        "leaseId",
        "manifestDigest",
        "workspaceRef",
        "workspaceGeneration"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "runId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/runId"
        },
        "leaseId": {
          "type": "string",
          "pattern": "^lease_[A-Za-z0-9_-]{8,128}$"
        },
        "manifestDigest": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/digest"
        },
        "workspaceRef": {
          "$ref": "https://agentroom.dev/schemas/bridge/messages.schema.json#/$defs/workspaceRef"
        },
        "workspaceGeneration": {
          "$ref": "https://agentroom.dev/schemas/bridge/messages.schema.json#/$defs/workspaceGeneration"
        }
      }
    },
    "runtimeAuthorityView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "runId",
        "leaseId",
        "manifestDigest",
        "workspaceRef",
        "workspaceGeneration",
        "state",
        "leaseRevision",
        "checkedAt",
        "expiresAt"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "runId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/runId"
        },
        "leaseId": {
          "type": "string",
          "pattern": "^lease_[A-Za-z0-9_-]{8,128}$"
        },
        "manifestDigest": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/digest"
        },
        "workspaceRef": {
          "$ref": "https://agentroom.dev/schemas/bridge/messages.schema.json#/$defs/workspaceRef"
        },
        "workspaceGeneration": {
          "$ref": "https://agentroom.dev/schemas/bridge/messages.schema.json#/$defs/workspaceGeneration"
        },
        "state": {
          "const": "active"
        },
        "leaseRevision": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/revision"
        },
        "checkedAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        },
        "expiresAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        }
      }
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingId",
        "planId",
        "planRevision",
        "edgeKey",
        "gate",
        "gateOperationId",
        "gateDigest",
        "sourceTaskId",
        "sourceDefinitionRevision",
        "sourceCriteriaRevision",
        "sourceResultId",
        "sourceResultVersion",
        "sourceOutputSlot",
        "artifact",
        "repositoryId",
        "sourceCommit",
        "sourceTree",
        "destinationTaskId",
        "destinationRunId",
        "destinationAgentId",
        "destinationDeviceId",
        "inputSlot",
        "issuedAt",
        "expiresAt"
      ],
      "properties": {
        "bindingId": {
          "$ref": "#/$defs/inputBindingId"
        },
        "planId": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/planId"
        },
        "planRevision": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/revision"
        },
        "edgeKey": {
          "oneOf": [
            {
              "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/stableKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "gate": {
          "enum": [
            "accepted_result",
            "verified_output",
            "integrated_commit"
          ]
        },
        "gateOperationId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/operationId"
        },
        "gateDigest": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/digest"
        },
        "sourceTaskId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/taskId"
        },
        "sourceDefinitionRevision": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/revision"
        },
        "sourceCriteriaRevision": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/revision"
        },
        "sourceResultId": {
          "oneOf": [
            {
              "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/resultId"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceResultVersion": {
          "oneOf": [
            {
              "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceAuthority": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceEvidenceId",
                "sourceDigest",
                "adoptionId",
                "adoptionDigest"
              ],
              "properties": {
                "sourceEvidenceId": {
                  "$ref": "https://agentroom.dev/schemas/work/evidence-adoption.schema.json#/$defs/sourceEvidenceId"
                },
                "sourceDigest": {
                  "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/digest"
                },
                "adoptionId": {
                  "$ref": "https://agentroom.dev/schemas/work/evidence-adoption.schema.json#/$defs/adoptionId"
                },
                "adoptionDigest": {
                  "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/digest"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceOutputSlot": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/stableKey"
        },
        "artifact": {
          "$ref": "#/$defs/artifactSnapshot"
        },
        "repositoryId": {
          "oneOf": [
            {
              "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/repositoryId"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceCommit": {
          "oneOf": [
            {
              "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/gitObjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceTree": {
          "oneOf": [
            {
              "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/gitObjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "destinationTaskId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/taskId"
        },
        "destinationRunId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/runId"
        },
        "destinationAgentId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/agentId"
        },
        "destinationDeviceId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/deviceId"
        },
        "inputSlot": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/stableKey"
        },
        "issuedAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        },
        "expiresAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        }
      }
    },
    "capturePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "rootTaskId",
        "outputs"
      ],
      "properties": {
        "operationId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/operationId"
        },
        "rootTaskId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/taskId"
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slotKey",
              "title",
              "summary",
              "path"
            ],
            "properties": {
              "slotKey": {
                "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/stableKey"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "path": {
                "oneOf": [
                  {
                    "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/pathPrefix"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "scope",
        "repository",
        "grant",
        "workspace",
        "inputs",
        "inputDigest",
        "scopePolicy",
        "verificationProfiles",
        "outputs",
        "deadline",
        "manifestDigest"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "scope": {
          "$ref": "#/$defs/executionScope"
        },
        "repository": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/repositoryInput"
        },
        "grant": {
          "$ref": "#/$defs/grantSnapshot"
        },
        "workspace": {
          "$ref": "#/$defs/workspaceLease"
        },
        "inputs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/inputBinding"
          }
        },
        "inputDigest": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/digest"
        },
        "scopePolicy": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/scopePolicy"
        },
        "verificationProfiles": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/verificationProfile"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/artifactSlot"
          }
        },
        "capture": {
          "$ref": "#/$defs/capturePlan"
        },
        "deadline": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        },
        "manifestDigest": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/digest"
        }
      }
    },
    "bindingSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingId",
        "repositoryId",
        "deviceId",
        "revision",
        "observedCommit",
        "workspaceRef",
        "workspaceGeneration",
        "capability",
        "runtimeProfile",
        "verificationProfiles",
        "updatedAt"
      ],
      "properties": {
        "bindingId": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/bindingId"
        },
        "repositoryId": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/repositoryId"
        },
        "deviceId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/deviceId"
        },
        "revision": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/revision"
        },
        "observedCommit": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/gitObjectId"
        },
        "workspaceRef": {
          "$ref": "https://agentroom.dev/schemas/bridge/messages.schema.json#/$defs/workspaceRef"
        },
        "workspaceGeneration": {
          "$ref": "https://agentroom.dev/schemas/bridge/messages.schema.json#/$defs/workspaceGeneration"
        },
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "runtimeProfile": {
          "$ref": "#/$defs/profilePin"
        },
        "verificationProfiles": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/profilePin"
          }
        },
        "updatedAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        }
      }
    },
    "grantSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant",
        "repositoryId",
        "bindingId",
        "deviceId",
        "agentId",
        "planId",
        "nodeKey",
        "operations",
        "runtimeProfile",
        "verificationProfiles",
        "scopePolicy",
        "integrationTargets",
        "issuedAt",
        "revokedAt"
      ],
      "properties": {
        "grant": {
          "$ref": "#/$defs/grantSnapshot"
        },
        "repositoryId": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/repositoryId"
        },
        "bindingId": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/bindingId"
        },
        "deviceId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/deviceId"
        },
        "agentId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/agentId"
        },
        "planId": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/planId"
        },
        "nodeKey": {
          "$ref": "https://agentroom.dev/schemas/work/execution-plan.schema.json#/$defs/stableKey"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/operationKind"
          },
          "uniqueItems": true
        },
        "runtimeProfile": {
          "$ref": "#/$defs/profilePin"
        },
        "verificationProfiles": {
          "type": "array",
          "minItems": 0,
