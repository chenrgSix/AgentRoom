{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentroom.dev/schemas/bridge/pairing-session.schema.json",
  "title": "ConveneWire Device Pairing Session",
  "description": "Transport-neutral payloads for Owner-created, zero-copy Device pairing sessions. Public projections never contain claim, poll, Device, Server, Runtime, or Owner credential plaintext.",
  "$ref": "#/$defs/ownerProjection",
  "$defs": {
    "pairingSessionState": {
      "type": "string",
      "enum": [
        "issued",
        "claimed",
        "approved",
        "consumed",
        "rejected",
        "canceled",
        "expired"
      ]
    },
    "highEntropySecret": {
      "type": "string",
      "minLength": 43,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "shortCode": {
      "type": "string",
      "pattern": "^[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{2}$"
    },
    "verificationPhrase": {
      "type": "string",
      "minLength": 8,
      "maxLength": 48,
      "pattern": "^[A-Z]{2,20}-[A-Z]{2,20}-[0-9]{2}$"
    },
    "privateTrustDescriptor": {
      "title": "Origin-scoped Private CA Trust Descriptor",
      "description": "Public bootstrap metadata for one exact Central origin. The CA certificate is fetched separately and accepted only when its canonical DER digest matches.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "origin",
        "installationId",
        "trustEpoch",
        "caCertificateSha256"
      ],
      "properties": {
        "mode": {
          "const": "private_scoped_ca"
        },
        "origin": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://[^/?#]+$",
          "not": {
            "pattern": "^https://[^/?#]*@"
          }
        },
        "installationId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/installationId"
        },
        "trustEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "caCertificateSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "privateCaRotationOffer": {
      "title": "Origin-scoped Private CA Rotation Offer",
      "description": "A next-epoch public CA offered only to an authenticated Device over its current pin-valid channel.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentTrustEpoch",
        "nextTrust",
        "caCertificatePem",
        "overlapEndsAt"
      ],
      "properties": {
        "currentTrustEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "nextTrust": {
          "$ref": "#/$defs/privateTrustDescriptor"
        },
        "caCertificatePem": {
          "type": "string",
          "minLength": 128,
          "maxLength": 8192,
          "pattern": "^-----BEGIN CERTIFICATE-----\\r?\\n[A-Za-z0-9+/=\\r\\n]+-----END CERTIFICATE-----\\r?\\n?$"
        },
        "overlapEndsAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        }
      }
    },
    "privateCaRotationAcknowledgeRequest": {
      "title": "Origin-scoped Private CA Rotation Acknowledgement",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "expectedCurrentTrustEpoch",
        "acceptedNextTrustEpoch",
        "caCertificateSha256"
      ],
      "properties": {
        "operationId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/operationId"
        },
        "expectedCurrentTrustEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "acceptedNextTrustEpoch": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2147483647
        },
        "caCertificateSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "deviceMetadata": {
      "title": "Pairing Device Metadata",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "platform",
        "bridgeVersion"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "platform": {
          "type": "string",
          "enum": [
            "darwin-amd64",
            "darwin-arm64",
            "linux-amd64",
            "linux-arm64",
            "windows-amd64",
            "windows-arm64"
          ]
        },
        "bridgeVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
        },
        "supportsScopedPrivateTrust": {
          "type": "boolean"
        }
      }
    },
    "createRequest": {
      "title": "Device Pairing Session Create Request",
      "description": "The authenticated Owner client generates claimSecret and resends the same secret with operationId after response loss; the Server stores only its hash and never echoes it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "claimSecret"
      ],
      "properties": {
        "operationId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/operationId"
        },
        "claimSecret": {
          "$ref": "#/$defs/highEntropySecret"
        }
      }
    },
    "created": {
      "title": "Device Pairing Session Created",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairingSessionId",
        "teamId",
        "ownerMemberId",
        "state",
        "shortCode",
        "createdAt",
        "expiresAt"
      ],
      "properties": {
        "pairingSessionId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/pairingSessionId"
        },
        "teamId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/teamId"
        },
        "ownerMemberId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/memberId"
        },
        "state": {
          "const": "issued"
        },
        "shortCode": {
          "$ref": "#/$defs/shortCode"
        },
        "createdAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        },
        "expiresAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        },
        "trust": {
          "$ref": "#/$defs/privateTrustDescriptor"
        }
      }
    },
    "ownerProjection": {
      "title": "Device Pairing Session Owner Projection",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairingSessionId",
        "teamId",
        "ownerMemberId",
        "state",
        "createdAt",
        "expiresAt"
      ],
      "properties": {
        "pairingSessionId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/pairingSessionId"
        },
        "teamId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/teamId"
        },
        "ownerMemberId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/memberId"
        },
        "state": {
          "$ref": "#/$defs/pairingSessionState"
        },
        "pairingAttemptId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/pairingAttemptId"
        },
        "device": {
          "$ref": "#/$defs/deviceMetadata"
        },
        "verificationPhrase": {
          "$ref": "#/$defs/verificationPhrase"
        },
        "deviceId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/deviceId"
        },
        "createdAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        },
        "expiresAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        },
        "claimedAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        },
        "decidedAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        },
        "consumedAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        },
        "trust": {
          "$ref": "#/$defs/privateTrustDescriptor"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "claimed",
                  "approved",
                  "consumed",
                  "rejected"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "pairingAttemptId": {},
              "device": {},
              "verificationPhrase": {},
              "claimedAt": {}
            },
            "required": [
              "pairingAttemptId",
              "device",
              "verificationPhrase",
              "claimedAt"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "approved",
                  "consumed"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "deviceId": {},
              "decidedAt": {}
            },
            "required": [
              "deviceId",
              "decidedAt"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "rejected"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "decidedAt": {}
            },
            "required": [
              "decidedAt"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "consumed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "consumedAt": {}
            },
            "required": [
              "consumedAt"
            ]
          }
        }
      ]
    },
    "claimRequest": {
      "title": "Device Pairing Session Claim Request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "pairingAttemptId",
        "pollSecret",
        "device"
      ],
      "properties": {
        "operationId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/operationId"
        },
        "pairingSessionId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/pairingSessionId"
        },
        "claimSecret": {
          "$ref": "#/$defs/highEntropySecret"
        },
        "shortCode": {
          "$ref": "#/$defs/shortCode"
        },
        "pairingAttemptId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/pairingAttemptId"
        },
        "pollSecret": {
          "$ref": "#/$defs/highEntropySecret"
        },
        "device": {
          "$ref": "#/$defs/deviceMetadata"
        },
        "trust": {
          "$ref": "#/$defs/privateTrustDescriptor"
        }
      },
      "oneOf": [
        {
          "properties": {
            "pairingSessionId": {},
            "claimSecret": {}
          },
          "required": [
            "pairingSessionId",
            "claimSecret"
          ],
          "not": {
            "properties": {
              "shortCode": {}
            },
            "required": [
              "shortCode"
            ]
          }
        },
        {
          "properties": {
            "shortCode": {}
          },
          "required": [
            "shortCode"
          ],
          "not": {
            "anyOf": [
              {
                "properties": {
                  "pairingSessionId": {}
                },
                "required": [
                  "pairingSessionId"
                ]
              },
              {
                "properties": {
                  "claimSecret": {}
                },
                "required": [
                  "claimSecret"
                ]
              },
              {
                "properties": {
                  "trust": {}
                },
                "required": [
                  "trust"
                ]
              }
            ]
          }
        }
      ]
    },
    "claimed": {
      "title": "Device Pairing Session Claimed",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairingSessionId",
        "pairingAttemptId",
        "state",
        "verificationPhrase",
        "expiresAt",
        "pollIntervalMs"
      ],
      "properties": {
        "pairingSessionId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/pairingSessionId"
        },
        "pairingAttemptId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/pairingAttemptId"
        },
        "state": {
          "const": "claimed"
        },
        "verificationPhrase": {
          "$ref": "#/$defs/verificationPhrase"
        },
        "expiresAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        },
        "pollIntervalMs": {
          "type": "integer",
          "minimum": 500,
          "maximum": 10000
        }
      }
    },
    "pollRequest": {
      "title": "Device Pairing Session Poll Request",
      "description": "pairingAttemptId and pollSecret are the stable proof identity. Pending polls are not response-cached; terminal consumption is idempotent by this proof pair.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairingSessionId",
        "pairingAttemptId",
        "pollSecret"
      ],
      "properties": {
        "pairingSessionId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/pairingSessionId"
        },
        "pairingAttemptId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/pairingAttemptId"
        },
        "pollSecret": {
          "$ref": "#/$defs/highEntropySecret"
        }
      }
    },
    "pollPending": {
      "title": "Device Pairing Session Poll Pending",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairingSessionId",
        "pairingAttemptId",
        "state",
        "verificationPhrase",
        "expiresAt",
        "retryAfterMs"
      ],
      "properties": {
        "pairingSessionId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/pairingSessionId"
        },
        "pairingAttemptId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/pairingAttemptId"
        },
        "state": {
          "const": "claimed"
        },
        "verificationPhrase": {
          "$ref": "#/$defs/verificationPhrase"
        },
        "expiresAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        },
        "retryAfterMs": {
          "type": "integer",
          "minimum": 500,
          "maximum": 10000
        }
      }
    },
    "pollConsumed": {
      "title": "Device Pairing Session Poll Consumed",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairingSessionId",
        "pairingAttemptId",
        "state",
        "deviceId",
        "teamId",
        "ownerMemberId",
        "credentialSource"
      ],
      "properties": {
        "pairingSessionId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/pairingSessionId"
        },
        "pairingAttemptId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/pairingAttemptId"
        },
        "state": {
          "const": "consumed"
        },
        "deviceId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/deviceId"
        },
        "teamId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/teamId"
        },
        "ownerMemberId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/memberId"
        },
        "credentialSource": {
          "const": "poll_secret"
        }
      }
    },
    "pollTerminal": {
      "title": "Device Pairing Session Poll Terminal",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairingSessionId",
        "pairingAttemptId",
        "state",
        "expiresAt"
      ],
      "properties": {
        "pairingSessionId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/pairingSessionId"
        },
        "pairingAttemptId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/pairingAttemptId"
        },
        "state": {
          "type": "string",
          "enum": [
            "rejected",
            "canceled",
            "expired"
          ]
        },
        "expiresAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        }
      }
    },
    "pollProjection": {
      "title": "Device Pairing Session Poll Projection",
      "oneOf": [
        {
          "$ref": "#/$defs/pollPending"
        },
        {
          "$ref": "#/$defs/pollConsumed"
        },
        {
          "$ref": "#/$defs/pollTerminal"
        }
      ]
    },
    "approveRequest": {
      "title": "Device Pairing Session Approve Request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "expectedState"
      ],
      "properties": {
        "operationId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/operationId"
        },
        "expectedState": {
          "const": "claimed"
        }
      }
    },
    "rejectRequest": {
      "title": "Device Pairing Session Reject Request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "expectedState"
      ],
      "properties": {
        "operationId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/operationId"
        },
        "expectedState": {
          "const": "claimed"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        }
      }
    },
    "cancelRequest": {
      "title": "Device Pairing Session Cancel Request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "expectedState"
      ],
      "properties": {
        "operationId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/operationId"
        },
        "expectedState": {
          "type": "string",
          "enum": [
            "issued",
            "claimed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        }
      }
    }
  }
}
