{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentroom.dev/schemas/bridge/messages.schema.json",
  "title": "Agent Room Bridge Message",
  "description": "Versioned messages exchanged over the authenticated Bridge WebSocket.",
  "allOf": [
    {
      "$ref": "https://agentroom.dev/schemas/common/message-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "bridge.hello",
            "bridge.heartbeat",
            "agent.publish",
            "agent.status",
            "run.requested",
            "run.accepted",
            "run.status",
            "run.activity",
            "run.output_delta",
            "run.reply",
            "run.cancel_requested",
            "run.handoff_requested"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "run.activity"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/runActivityPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "run.output_delta"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/runOutputDeltaPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bridge.hello"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/bridgeHelloPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bridge.heartbeat"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/bridgeHeartbeatPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "agent.publish"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/agentPublishPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "agent.status"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/agentStatusPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "run.requested"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/runRequestedPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "run.accepted"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/runAcceptedPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "run.status"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/runStatusPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "run.reply"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/runReplyPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "run.cancel_requested"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/runCancelRequestedPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "run.handoff_requested"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/runHandoffRequestedPayload"
              }
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "runtimeScopeId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "connectionEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "bridgeJoinRequest": {
      "title": "Bridge Join Request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceName",
        "agentName",
        "agentRole"
      ],
      "properties": {
        "deviceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "agentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "agentRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "bridgeJoinChallenge": {
      "title": "Bridge Join Challenge",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "joinRequestId",
        "userCode",
        "pollToken",
        "expiresAt",
        "pollIntervalMs"
      ],
      "properties": {
        "joinRequestId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json"
        },
        "userCode": {
          "type": "string",
          "pattern": "^[0-9A-F]{4}-[0-9A-F]{4}$"
        },
        "pollToken": {
          "type": "string",
          "minLength": 40,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "expiresAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        },
        "pollIntervalMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        }
      }
    },
    "bridgeJoinApprovalRequest": {
      "title": "Bridge Join Approval Request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{4}-?[0-9A-Fa-f]{4}$"
        }
      }
    },
    "bridgeJoinApproval": {
      "title": "Bridge Join Approval",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "joinRequestId",
        "status",
        "deviceName",
        "agentName",
        "agentRole",
        "expiresAt"
      ],
      "properties": {
        "joinRequestId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json"
        },
        "status": {
          "const": "approved"
        },
        "deviceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "agentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "agentRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "expiresAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        }
      }
    },
    "bridgeJoinClaimRequest": {
      "title": "Bridge Join Claim Request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pollToken"
      ],
      "properties": {
        "pollToken": {
          "type": "string",
          "minLength": 40,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "bridgeJoinPending": {
      "title": "Bridge Join Pending",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "expiresAt"
      ],
      "properties": {
        "status": {
          "const": "pending"
        },
        "expiresAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        }
      }
    },
    "bridgeJoinPaired": {
      "title": "Bridge Join Paired",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "device",
        "credential"
      ],
      "properties": {
        "status": {
          "const": "paired"
        },
        "device": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "deviceId",
            "teamId",
            "ownerMemberId"
          ],
          "properties": {
            "deviceId": {
              "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/deviceId"
            },
            "teamId": {
              "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/teamId"
            },
            "ownerMemberId": {
              "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/memberId"
            }
          }
        },
        "credential": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "token",
            "expiresAt"
          ],
          "properties": {
            "token": {
              "type": "string",
              "minLength": 40,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "expiresAt": {
              "oneOf": [
                {
                  "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "runtimeCapabilities": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "invocationMode",
        "supportsStart",
        "supportsResume",
        "supportsStreaming",
        "supportsInterrupt",
        "supportsHandoff"
      ],
      "properties": {
        "invocationMode": {
          "enum": [
            "managed",
            "manual"
          ]
        },
        "supportsStart": {
          "type": "boolean"
        },
        "supportsResume": {
          "type": "boolean"
        },
        "supportsStreaming": {
          "type": "boolean"
        },
        "supportsInterrupt": {
          "type": "boolean"
        },
        "supportsHandoff": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "invocationMode": {
                "const": "manual"
              }
            },
            "required": [
              "invocationMode"
            ]
          },
          "then": {
            "properties": {
              "supportsStart": {
                "const": false
              },
              "supportsResume": {
                "const": false
              },
              "supportsInterrupt": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "bridgeHelloPayload": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "deviceId",
        "connectionEpoch",
        "bridgeVersion",
        "supportedProtocolVersions"
      ],
      "properties": {
        "deviceId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/deviceId"
        },
        "connectionEpoch": {
          "$ref": "#/$defs/connectionEpoch"
        },
        "bridgeVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "supportedProtocolVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://agentroom.dev/schemas/common/protocol-version.schema.json"
          }
        }
      }
    },
    "bridgeHeartbeatPayload": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "deviceId",
        "connectionEpoch"
      ],
      "properties": {
        "deviceId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/deviceId"
        },
        "connectionEpoch": {
          "$ref": "#/$defs/connectionEpoch"
        }
      }
    },
    "agentPublishPayload": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "teamId",
        "agentId",
        "ownerMemberId",
        "deviceId",
        "name",
        "role",
        "capabilities"
      ],
      "properties": {
        "teamId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/teamId"
        },
        "agentId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/agentId"
        },
        "ownerMemberId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/memberId"
        },
        "deviceId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/deviceId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "capabilities": {
          "$ref": "#/$defs/runtimeCapabilities"
        },
        "runtimeScopeId": {
          "$ref": "#/$defs/runtimeScopeId"
        }
      }
    },
    "agentStatusPayload": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "agentId",
        "deviceId",
        "connectionEpoch",
        "status"
      ],
      "properties": {
        "agentId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/agentId"
        },
        "deviceId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/deviceId"
        },
        "connectionEpoch": {
          "$ref": "#/$defs/connectionEpoch"
        },
        "status": {
          "title": "Agent Presence Status",
          "enum": [
            "ready",
            "busy",
            "degraded"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "contextMessage": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "messageId",
        "senderId",
        "content"
      ],
      "properties": {
        "messageId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/messageId"
        },
        "senderId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json"
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "content": {
          "type": "string",
          "maxLength": 32768
        },
        "sequence": {
          "$ref": "#/$defs/sequence"
        }
      }
    },
    "logicalSessionRequest": {
      "title": "Logical Session Request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "resumePolicy",
        "contextCursor"
      ],
      "properties": {
        "scope": {
          "const": "task"
        },
        "resumePolicy": {
          "enum": [
            "resume_or_start",
            "start_new"
          ]
        },
        "contextCursor": {
          "type": "integer",
          "minimum": 0
        },
        "runtimeScopeId": {
          "$ref": "#/$defs/runtimeScopeId"
        }
      }
    },
    "logicalSessionStatus": {
      "title": "Logical Session Status",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "contextCursor"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "started",
            "resumed",
            "recreated"
          ]
        },
        "contextCursor": {
          "type": "integer",
          "minimum": 0
        },
        "runtimeScopeId": {
          "$ref": "#/$defs/runtimeScopeId"
        },
        "resultEvidenceRevision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "contextMemoryProjection": {
      "title": "Context Memory Projection",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "sourceCursor",
        "revision",
        "sourceMessageIds"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "sourceCursor": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "projectionKind": {
          "enum": [
            "canonical",
            "historical"
          ]
        },
        "sourceMessageIds": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/messageId"
          }
        }
      }
    },
    "artifactRef": {
      "title": "Artifact Reference",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "type",
        "title",
        "summary",
        "createdAt"
      ],
      "oneOf": [
        {
          "properties": {
            "createdByMemberId": {}
          },
          "required": ["createdByMemberId"]
        },
        {
          "properties": {
            "createdByAgentId": {}
          },
          "required": ["createdByAgentId"]
        }
      ],
      "properties": {
        "artifactId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/artifactId"
        },
        "artifactRevision": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": [
            "commit",
            "branch",
            "file",
            "patch",
            "test_result",
            "document"
          ]
        },
        "workspaceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "sourceRunId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/runId"
        },
        "createdByMemberId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/memberId"
        },
        "createdByAgentId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/agentId"
        },
        "createdAt": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        }
      }
    },
    "taskResultEvidence": {
      "title": "Task Result Evidence",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "artifactRefs"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "deliveryKind": {
          "enum": [
            "bootstrap",
            "delta"
          ]
        },
        "fromRevision": {
          "type": "integer",
          "minimum": 0
        },
        "throughRevision": {
          "type": "integer",
          "minimum": 1
        },
        "hasMore": {
          "type": "boolean"
        },
        "artifactRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        }
      }
    },
    "longTermMemoryEntry": {
      "title": "Provenance Memory Entry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memoryId",
        "type",
        "content",
        "state",
        "revision",
        "sourceMessageIds",
        "sourceArtifactIds",
        "sourceRunIds",
        "sourceDiscussionIds"
      ],
      "anyOf": [
        { "properties": { "sourceMessageIds": { "$ref": "#/$defs/nonEmptyMemoryMessageIds" } } },
        { "properties": { "sourceArtifactIds": { "$ref": "#/$defs/nonEmptyMemoryArtifactIds" } } },
        { "properties": { "sourceRunIds": { "$ref": "#/$defs/nonEmptyMemoryRunIds" } } },
        { "properties": { "sourceDiscussionIds": { "$ref": "#/$defs/nonEmptyMemoryDiscussionIds" } } }
      ],
      "properties": {
        "memoryId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/opaqueId"
        },
        "type": {
          "enum": [
            "decision",
            "constraint",
            "fact",
            "open_question",
            "convention",
            "goal",
            "acceptance_criterion",
            "plan",
            "progress",
            "blocker",
            "result"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "state": {
          "enum": ["active", "superseded", "retracted"]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "supersedesMemoryId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/opaqueId"
        },
        "sourceMessageIds": {
          "$ref": "#/$defs/memoryMessageIds"
        },
        "sourceArtifactIds": {
          "$ref": "#/$defs/memoryArtifactIds"
        },
        "sourceRunIds": {
          "$ref": "#/$defs/memoryRunIds"
        },
        "sourceDiscussionIds": {
          "$ref": "#/$defs/memoryDiscussionIds"
        }
      }
    },
    "memoryMessageIds": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/messageId"
      }
    },
    "nonEmptyMemoryMessageIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/messageId"
      }
    },
    "memoryArtifactIds": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/artifactId"
      }
    },
    "nonEmptyMemoryArtifactIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/artifactId"
      }
    },
    "memoryRunIds": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/runId"
      }
    },
    "nonEmptyMemoryRunIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/runId"
      }
    },
    "memoryDiscussionIds": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/opaqueId"
      }
    },
    "nonEmptyMemoryDiscussionIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/opaqueId"
      }
    },
    "longTermMemoryScope": {
      "title": "Long-term Memory Scope Snapshot",
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "activeComplete", "entries"],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "activeComplete": {
          "type": "boolean"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/longTermMemoryEntry"
          }
        }
      }
    },
    "longTermMemoryPlan": {
      "title": "Long-term Provenance Memory Plan",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "room": {
          "$ref": "#/$defs/longTermMemoryScope"
        },
        "task": {
          "$ref": "#/$defs/longTermMemoryScope"
        }
      }
    },
    "runtimeContextPlan": {
      "title": "Runtime Context Plan",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "roomMemory": {
          "$ref": "#/$defs/contextMemoryProjection"
        },
        "taskMemory": {
          "$ref": "#/$defs/contextMemoryProjection"
        },
        "resultEvidence": {
          "$ref": "#/$defs/taskResultEvidence"
        },
        "longTermMemory": {
          "$ref": "#/$defs/longTermMemoryPlan"
        }
      }
    },
    "runRequestedPayload": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "runId",
        "traceId",
        "roomId",
        "triggerMessageId",
        "requesterMemberId",
        "targetAgentId",
        "deliveryAttemptId",
        "idempotencyKey",
        "instruction",
        "contextMessages",
        "deadline"
      ],
      "properties": {
        "runId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/runId"
        },
        "traceId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/traceId"
        },
        "roomId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/roomId"
        },
        "taskId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/taskId"
        },
        "session": {
          "$ref": "#/$defs/logicalSessionRequest"
        },
        "triggerMessageId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/messageId"
        },
        "requesterMemberId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/memberId"
        },
        "targetAgentId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/agentId"
        },
        "targetAgentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "deliveryAttemptId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/deliveryAttemptId"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "parentRunId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/runId"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "contextMessages": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/contextMessage"
          }
        },
        "contextPlan": {
          "$ref": "#/$defs/runtimeContextPlan"
        },
        "routingAgents": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/routingAgent"
          }
        },
        "deadline": {
          "$ref": "https://agentroom.dev/schemas/common/utc-timestamp.schema.json"
        }
      }
    },
    "routingAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentId",
        "name"
      ],
      "properties": {
        "agentId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/agentId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "runEventBase": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "runId",
        "traceId",
        "agentId",
        "sequence"
      ],
      "properties": {
        "runId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/runId"
        },
        "traceId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/traceId"
        },
        "agentId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/agentId"
        },
        "sequence": {
          "$ref": "#/$defs/sequence"
        }
      }
    },
    "runAcceptedPayload": {
      "$ref": "#/$defs/runEventBase"
    },
    "runStatusPayload": {
      "allOf": [
        {
          "$ref": "#/$defs/runEventBase"
        },
        {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "title": "Run Execution Status",
              "enum": [
                "working",
                "input_required",
                "completed",
                "failed",
                "canceled",
                "outcome_unknown"
              ]
            },
            "error": {
              "$ref": "https://agentroom.dev/schemas/common/error.schema.json"
            },
            "session": {
              "$ref": "#/$defs/logicalSessionStatus"
            },
            "clarification": {
              "$ref": "#/$defs/taskClarificationRequest"
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "clarification"
                ],
                "properties": {
                  "clarification": {}
                }
              },
              "then": {
                "properties": {
                  "status": {
                    "const": "input_required"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "taskClarificationRequest": {
      "title": "Task Clarification Request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "question"
      ],
      "properties": {
        "kind": {
          "const": "task"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "agentAssessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "goalSatisfied": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "resolvedQuestionIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "openQuestions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "question",
              "importance"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "importance": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          }
        },
        "newEvidenceRefs": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "disagreementRemaining": {
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ]
        },
        "newInformationAdded": {
          "type": "boolean"
        },
        "reviewerApproved": {
          "type": "boolean"
        },
        "recommendation": {
          "enum": [
            "continue",
            "finish",
            "wait_human"
          ]
        }
      },
      "minProperties": 1
    },
    "runOutputDeltaPayload": {
      "allOf": [
        {
          "$ref": "#/$defs/runEventBase"
        },
        {
          "type": "object",
          "required": [
            "content"
          ],
          "properties": {
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            "reset": {
              "type": "boolean",
              "default": false
            }
          }
        }
      ]
    },
    "runActivityPayload": {
      "allOf": [
        {
          "$ref": "#/$defs/runEventBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "activityId",
            "kind",
            "phase"
          ],
          "properties": {
            "runId": true,
            "traceId": true,
            "agentId": true,
            "sequence": true,
            "activityId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "kind": {
              "$ref": "#/$defs/runActivityKind"
            },
            "phase": {
              "$ref": "#/$defs/runActivityPhase"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "reset": {
              "type": "boolean",
              "default": false
            }
          }
        }
      ]
    },
    "runActivityKind": {
      "title": "Run Activity Kind",
      "type": "string",
      "pattern": "^(reasoning|tool)$"
    },
    "runActivityPhase": {
      "title": "Run Activity Phase",
      "type": "string",
      "pattern": "^(started|updated|completed|failed)$"
    },
    "runReplyPayload": {
      "allOf": [
        {
          "$ref": "#/$defs/runEventBase"
        },
        {
          "type": "object",
          "required": [
            "content"
          ],
          "properties": {
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            "assessment": {
              "$ref": "#/$defs/agentAssessment"
            }
          }
        }
      ]
    },
    "runCancelRequestedPayload": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "runId",
        "traceId",
        "agentId",
        "reason"
      ],
      "properties": {
        "runId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/runId"
        },
        "traceId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/traceId"
        },
        "agentId": {
          "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/agentId"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "runHandoffRequestedPayload": {
      "allOf": [
        {
          "$ref": "#/$defs/runEventBase"
        },
        {
          "type": "object",
          "required": [
            "handoffId",
            "targetAgentId",
            "summary"
          ],
          "properties": {
            "handoffId": {
              "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/handoffId"
            },
            "targetAgentId": {
              "$ref": "https://agentroom.dev/schemas/common/identifiers.schema.json#/$defs/agentId"
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            }
          }
        }
      ]
    }
  }
}
