{
  "name": "@convene-wire/server",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Central ConveneWire Team service",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "db:migrate": "tsx src/data/migrate-cli.ts",
    "db:backup": "tsx src/data/backup-cli.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "tsx --test --test-concurrency=2 test/**/*.test.ts"
  },
  "dependencies": {
    "@convene-wire/contracts": "0.1.0",
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "11.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
