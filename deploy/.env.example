# Stable host name or LAN IP. Caddy obtains a public certificate where eligible
# and otherwise uses its local CA, whose root must be trusted by every client.
AGENT_ROOM_DOMAIN=team.example.com
AGENT_ROOM_PUBLIC_ORIGIN=https://team.example.com:9443

# Optional opaque Token required from Bridge join, pair, and WebSocket traffic.
# Generate one with `openssl rand -hex 32` and configure the same value in each
# remote Bridge. Leave empty only for a trusted token-free deployment.
AGENT_ROOM_BRIDGE_SERVER_TOKEN=

# Port 80 remains the ACME/redirect entrypoint. HTTPS defaults to 9443 and may
# be changed here; AGENT_ROOM_PUBLIC_ORIGIN must contain the same external port.
AGENT_ROOM_HTTP_PORT=80
AGENT_ROOM_HTTPS_PORT=9443

# Local image label. Set it to the checked-out tag for a release, or keep the
# generic value for a separately recorded commit. This is not a remote digest.
AGENT_ROOM_IMAGE_TAG=source-build

# Container path inside the persistent agentroom_data volume. Do not use a host
# absolute path here. Restore helpers stage additional files under /data.
AGENT_ROOM_DATABASE_PATH=/data/agent-room.sqlite

# Docker json-file rotation for the long-running Server and Caddy containers.
AGENT_ROOM_LOG_MAX_SIZE=10m
AGENT_ROOM_LOG_MAX_FILES=5

# Generate this untracked file with:
#   mkdir -p deploy/secrets
#   umask 077
#   openssl rand -hex 32 > deploy/secrets/owner_recovery_token
AGENT_ROOM_OWNER_RECOVERY_TOKEN_FILE=./deploy/secrets/owner_recovery_token
