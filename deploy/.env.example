# Host name only. Caddy obtains and renews its HTTPS certificate.
AGENT_ROOM_DOMAIN=team.example.com
AGENT_ROOM_PUBLIC_ORIGIN=https://team.example.com

# Production uses public 80/443. Port overrides are only for isolated local
# smoke tests; Caddy's automatic redirect still targets the standard HTTPS port.
AGENT_ROOM_HTTP_PORT=80
AGENT_ROOM_HTTPS_PORT=443

# Optional immutable image tag override.
AGENT_ROOM_IMAGE_TAG=v0.2.0-rc.1

# Generate this untracked file with:
#   mkdir -p deploy/secrets
#   umask 077
#   openssl rand -hex 32 > deploy/secrets/owner_recovery_token
AGENT_ROOM_OWNER_RECOVERY_TOKEN_FILE=./deploy/secrets/owner_recovery_token
