{
	auto_https disable_redirects
	default_sni {$AGENT_ROOM_DOMAIN}
}

http://{$AGENT_ROOM_DOMAIN} {
	redir {$AGENT_ROOM_PUBLIC_ORIGIN}{uri} permanent
}

https://{$AGENT_ROOM_DOMAIN} {
	import /etc/caddy/tls-profile.caddy

	encode zstd gzip

	@metrics path /api/metrics
	respond @metrics 404

	header {
		-Server
		Referrer-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	reverse_proxy agentroom:3000
}
